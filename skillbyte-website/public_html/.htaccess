# =============================================================================
# SkillByte — Apache configuration for cPanel shared hosting
#
# Every block is wrapped in <IfModule>, so if your host has a module disabled
# the rule is skipped rather than throwing a 500. If you do hit a 500 after
# uploading, rename this file to .htaccess-disabled, confirm the site loads,
# then re-add the sections one at a time to find the culprit.
# =============================================================================

# Serve everything as UTF-8 unless a file says otherwise.
AddDefaultCharset UTF-8

# -----------------------------------------------------------------------------
# Default document and error pages
# -----------------------------------------------------------------------------
DirectoryIndex index.html index.php

ErrorDocument 404 /404.html

# Stop visitors browsing directory contents where no index file exists.
Options -Indexes

# -----------------------------------------------------------------------------
# Force HTTPS and a single canonical hostname
#
# LEAVE THIS COMMENTED OUT until your SSL certificate is active in cPanel
# (Security > SSL/TLS Status > Run AutoSSL). Turning it on beforehand makes
# the site unreachable.
#
# It also sends www.connectskillbyte.com to the bare domain, matching the
# canonical URLs in the page <head>. If you would rather use www, swap the
# two rules.
# -----------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#
#   # http -> https
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://connectskillbyte.com/$1 [R=301,L]
#
#   # www -> bare domain
#   RewriteCond %{HTTP_HOST} ^www\.connectskillbyte\.com$ [NC]
#   RewriteRule ^(.*)$ https://connectskillbyte.com/$1 [R=301,L]
# </IfModule>

# -----------------------------------------------------------------------------
# Compression — the single biggest win for visitors on mobile data
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# Brotli, where the host offers it. Better than gzip; harmless if absent.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>

# WOFF2 is already compressed — running it through gzip wastes CPU and
# occasionally corrupts it on older hosts.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI \.woff2$ no-gzip dont-vary
</IfModule>

# -----------------------------------------------------------------------------
# Caching
#
# Fonts, images and CSS/JS are cached hard. HTML is not, so content edits go
# live immediately. If you change a CSS or JS file and want the change picked
# up straight away, bump the ?v= number on its <link> or <script> tag.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType text/javascript               "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"
  ExpiresByType application/manifest+json     "access plus 1 week"
  ExpiresDefault                              "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg|png|jpe?g|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ---------------------------------------------------------------------------
  # Security headers
  # ---------------------------------------------------------------------------

  # Stop browsers guessing a file's type against its declared one.
  Header always set X-Content-Type-Options "nosniff"

  # Block the site being framed by someone else (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"

  # Send the full URL to our own pages, only the origin to other sites.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # We use none of these APIs. Deny them so an injected script cannot either.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

  # Content Security Policy.
  # The site loads no third-party resources at all — fonts are self-hosted —
  # so this can be strict. 'unsafe-inline' is needed for the small inline
  # theme script in <head> and the inline style attributes.
  #
  # IF YOU ADD Google Analytics, Meta Pixel or any embed, this WILL block it.
  # Add the vendor's domain to script-src / connect-src / img-src, or comment
  # the header out while you work out which directive it needs.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

  # HSTS — only enable once HTTPS is working and you are sure. Once a browser
  # has seen this header it will refuse plain http for a year.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# -----------------------------------------------------------------------------
# Correct MIME types, in case the host has not set them
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2                  .woff2
  AddType image/svg+xml               .svg
  AddType image/webp                  .webp
  AddType application/manifest+json   .webmanifest
</IfModule>

# -----------------------------------------------------------------------------
# Protect files that should never be served
# -----------------------------------------------------------------------------
<FilesMatch "^(\.htaccess|\.htpasswd|\.git.*|.*\.log|.*\.md|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

# -----------------------------------------------------------------------------
# Optional: drop the .html from URLs (/services instead of /services.html)
#
# If you enable this, also update the <link rel="canonical"> tag in every page
# and the URLs in sitemap.xml to match, or search engines will see two URLs
# for each page.
# -----------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#
#   # Send /services.html to /services permanently
#   RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
#   RewriteRule ^ /%1 [R=301,L]
#
#   # Serve /services from services.html
#   RewriteCond %{REQUEST_FILENAME}.html -f
#   RewriteRule ^(.*)$ $1.html [L]
# </IfModule>
