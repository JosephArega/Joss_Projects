# ---------------------------------------------------------------------------
# systemd unit for the Information Desk.
#
#   sudo cp deploy/information-desk.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now information-desk
#   sudo journalctl -u information-desk -f
#
# Expects the app at /opt/information-desk and the environment file at
# /etc/information-desk.env (mode 0600, owned by root) — not a .env inside the
# checkout, so secrets never sit next to the code.
# ---------------------------------------------------------------------------

[Unit]
Description=Information Desk service portal
Documentation=file:/opt/information-desk/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=information-desk
Group=information-desk
WorkingDirectory=/opt/information-desk/server
EnvironmentFile=/etc/information-desk.env
ExecStart=/usr/bin/node dist/index.js

Restart=on-failure
RestartSec=5s
# Give up if it crash-loops, rather than hammering the database.
StartLimitIntervalSec=120
StartLimitBurst=5

# Boot fails loudly on an unreachable database or an unmigrated schema, so a
# short timeout is enough to surface the problem in the journal.
TimeoutStartSec=30
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=information-desk

# --- Hardening -------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=

[Install]
WantedBy=multi-user.target
