# ---------------------------------------------------------------------------
# Information Desk — environment configuration
# Copy to .env and fill in real values.  NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=4000

# Public origin the browser uses to reach this app.  CORS is locked to it and
# it is used to build absolute URLs.  Must be https:// in production because
# the session cookie is issued with the Secure flag.
APP_ORIGIN=https://desk.example.org

# --- Database --------------------------------------------------------------
# Points at your EXISTING PostgreSQL server.  The app never creates a server.
DATABASE_URL=postgres://portal_user:change-me@localhost:5432/portal

# Optional. One of: disable | no-verify | require | verify-ca | verify-full
# Leave unset for a local trusted network; use "require" for managed Postgres.
# PGSSLMODE=require

# Optional CA bundle when PGSSLMODE=verify-ca / verify-full
# PGSSLROOTCERT=/etc/ssl/certs/rds-ca.pem

# Pool sizing (optional)
# PGPOOL_MAX=10

# --- Auth ------------------------------------------------------------------
# Long random string. Generate with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters

# The first admin is seeded at boot if the admins table is empty.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-this-on-first-login

# Session lifetime in hours (default 8, sliding refresh on activity)
# SESSION_HOURS=8

# Set to "false" ONLY for local http:// development. In production leave unset
# so the auth cookie keeps its Secure flag.
# COOKIE_SECURE=false

# --- Branding (optional, surfaced in the UI) -------------------------------
ORG_NAME=Contoso Group
SUPPORT_EMAIL=servicedesk@example.org
SUPPORT_PHONE=ext. 4000
